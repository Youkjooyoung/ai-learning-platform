{
  "name": "ai-learning-platform",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "test:api": "cd apps/api && pytest",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload",
    "docker:up": "docker compose -f infra/docker/compose.yml up --build",
    "docker:down": "docker compose -f infra/docker/compose.yml down"
  }
}
